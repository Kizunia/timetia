# Copy to .env with `pnpm bootstrap`, which fills the CHANGE_ME values with freshly generated random secrets.
# .env is for local development only and is never committed (see .gitignore).
# Names only here; every variable is listed in kibootia-docs/operations/configuration/application-configuration.md.

# --- Database (read by compose.yaml and by the backend) ---
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

# --- Keycloak (read by compose.yaml; the realm is applied by the one-shot OpenTofu container) ---
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_WEB_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
# Password of the local demo user (username: demo). Local only; the production overlay has no demo data.
DEMO_USER_PASSWORD=CHANGE_ME
# Password of the local administrator (username: demo-admin). Local only. The backend makes the address below the
# first administrator when it signs in, while no administrator exists (ADR 0025).
DEMO_ADMIN_PASSWORD=CHANGE_ME
KIBOOTIA_BOOTSTRAP_ADMIN_EMAIL=demo-admin@timetia.localhost

# --- Object storage (read by compose.yaml, which starts RustFS, and by the backend; ADR 0029) ---
# The access key and secret key of the local S3 server. Generated, URL-safe. Local only.
KIBOOTIA_FILES_ACCESS_KEY=CHANGE_ME
KIBOOTIA_FILES_SECRET_KEY=CHANGE_ME

# --- Next.js server ---
# Derives the key that encrypts the session cookie.
SESSION_SECRET=CHANGE_ME

# --- Compose ---
# Profiles started by `docker compose up`. Remove `observability` to leave out the Grafana LGTM container, and `files`
# to leave out the object store (then also set KIBOOTIA_FILES_ENABLED=false, or uploads answer 503).
COMPOSE_PROFILES=observability,files

# --- Module switches (ADR 0024; the removal recipes are in kibootia-docs/recipes) ---
# Set to false to switch the module off: the application starts without it and its endpoints answer 404 `<module>.disabled`.
KIBOOTIA_FILES_ENABLED=true
KIBOOTIA_OBSERVABILITY_ENABLED=true
