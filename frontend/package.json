{
  "name": "kibootia-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Kibootia web application: Next.js server with the backend-for-frontend session and API proxy.",
  "scripts": {
    "dev": "next dev --port 3470",
    "build": "next build",
    "start": "next start --port 3470",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript ../backend/openapi.json --output src/lib/api/schema.gen.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.5",
    "@opentelemetry/api": "1.10.0",
    "@tanstack/react-query": "5.107.1",
    "@vercel/otel": "2.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "jose": "6.2.15",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "openapi-fetch": "0.17.0",
    "openid-client": "6.8.9",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
